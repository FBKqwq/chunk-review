    {
      "chunk_id": "CH0007",
      "section_title": "四、病理改变",
      "section_path": [
        "正文",
        "四、病理改变"
      ],
      "page_start": 2,
      "page_end": 2,
      "page_span": {
        "start": {
          "page": 2,
          "offset": 271
        },
        "end": {
          "page": 2,
          "offset": 414
        }
      },
      "text_span": {
        "start": 731,
        "end": 874
      },
      "text": "四、病理改变\n水痘初期病变为皮肤真皮层毛细血管内皮细胞肿胀，血\n管扩张充血；随后棘细胞层上皮细胞肿胀溶解，间质液积聚，\n形成单房水疱疹；多形核细胞浸入疱疹液转为云雾状；最终\n疱疹液吸收，形成结痂。水痘肺炎时可见间质性肺炎伴结节\n性实变出血区。水痘脑炎主要为白质区血管周围脱髓鞘病\n变。",
      "text_quality": {
        "cjk_ratio": 0.9191
      },
