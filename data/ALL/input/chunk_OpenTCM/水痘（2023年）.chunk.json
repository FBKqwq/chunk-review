    {
      "chunk_id": "CH0012",
      "section_title": "九、治疗",
      "section_path": [
        "正文",
        "九、治疗"
      ],
      "page_start": 7,
      "page_end": 9,
      "page_span": {
        "start": {
          "page": 7,
