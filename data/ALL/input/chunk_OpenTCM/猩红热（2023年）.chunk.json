      "chunk_id": "CH0004",
      "section_title": "一、病原学",
      "section_path": [
        "正文",
        "一、病原学"
      ],
      "page_start": 1,
      "page_end": 2,
      "page_span": {
        "start": {
          "page": 1,
          "offset": 178
        },
        "end": {
