          "chunk_id": "__FULL_DOCUMENT__",
          "evidence_ids": [
            "眼损害：亦称眼白塞综合征。眼是BS最常见的受累脏器，可见于26.8%~93%的BS患者，约15%的患者以眼病变为首发表现，如不及时治疗，可导致失明，是本病致残最主要的原因。眼白塞综合征好发于20~30岁人群，男性更多见且症状更重，预后差。"
          ],
          "confidence": 0.9
        },
