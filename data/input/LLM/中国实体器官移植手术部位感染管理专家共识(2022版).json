    "treatments": [
      {
        "id": "treatment_ssi_surgical_drainage",
        "content": "强调病因治疗，重视引流、清创，采用介入或外科手段干预，解除吻合口漏和充分引流是治疗的关键。",
        "recommendation_strength": "strong",
        "source_section": "１．３．２ 治疗措施",
        "evidence_ids": [
