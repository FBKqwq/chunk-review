        "evidence_ids": [
          "念珠菌病（candidiasis）是由各种致病性念珠菌引起的局部或全身感染性疾病，好发于免疫功能低下患者，可侵犯局部皮肤、黏膜以及全身各组织、器官，临床表现多样、轻重不一。"
        ],
        "confidence": 0.95
      }
    ],
    "sub_diseases": [
