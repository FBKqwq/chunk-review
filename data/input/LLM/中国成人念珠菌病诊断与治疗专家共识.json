        "age_min": null,
        "age_max": null,
        "evidence_ids": [
          "播散性念珠菌病（disseminated candidiasis）是指念珠菌侵入血循环，并在血液中生长繁殖后，进一步播散至2个或2个以上不相邻器官，引起相应器官感染。"
        ],
        "confidence": 0.9
      },
