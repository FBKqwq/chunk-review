        "age_max": null,
        "evidence_ids": [
          "侵袭性念珠菌病（invasive candidiasis）发病率呈明显上升趋势。其中，念珠菌血症是侵袭性念珠菌病最常见的临床类型，常预后不佳。"
        ],
        "confidence": 0.9
