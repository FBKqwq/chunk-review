        "recommendation_strength": "strong",
        "source_section": "营养支持",
        "evidence_ids": [
          "当病人存在营养不良或营养不良风险时，应给予肠内或肠外营养支持，而不能仅给予普通液体。肠外营养与肠内营养相比，优先考虑肠内营养"
        ],
        "confidence": 0.9
      }
