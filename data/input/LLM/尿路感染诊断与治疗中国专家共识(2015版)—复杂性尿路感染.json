    "treatments": [
      {
        "id": "treatment_complicated_uti_antibiotic",
        "content": "推荐根据尿培养和药敏试验结果选择敏感抗菌药物。对于有症状复杂尿路感染的经验治疗需要了解可能的病原菌谱和当地的耐药情况，还要对基础泌尿系统疾病的严重程度进行评估（包括对肾功能的评估）。抗菌药物的经验性治疗需根据临床反应和尿培养结果及时进行修正。",
        "recommendation_strength": "strong",
        "source_section": "三、治疗 (一)抗菌药物治疗",
        "evidence_ids": [
          "推荐根据尿培养和药敏试验结果选择敏感抗菌药物。对于有症状复杂尿路感染的经验治疗需要了解可能的病原菌谱和当地的耐药情况．还要对基础泌尿系统疾病的严重程度进行评估(包括对肾功能的评估)。抗菌药物的经验性治疗需根据临床反应和尿培养结果及时进行修正。"
        ],
        "confidence": 0.95
      },
      {
        "id": "treatment_complicated_uti_surgical",
        "content": "积极手术治疗引起或加重尿路感染的尿路梗阻性疾病，包括结石、肿瘤、狭窄、先天性畸形或神经源性膀胱等。在施行手术前要控制好感染以免手术时继发尿源性脓毒血症。",
        "recommendation_strength": "strong",
        "source_section": "三、治疗 (二)外科手术治疗",
        "evidence_ids": [
