      ">",
      ">=",
      "<",
      "<=",
      "between",
      "equals",
      "contains",
      null
    ],
    "rules": {
      "diagnostic_target_is_sub_disease": true,
      "test_reference_range_only_in_test_entity": true,
      "diagnostic_threshold_only_in_requires_test": true,
      "gold_standard_weight_100_only_when_explicit": true,
      "evidence_ids_use_original_text_span_before_id_backfill": true
    }
  }
}