        "clinical_stage": "不限定",
        "severity": "重症",
        "population": "幼托及学龄儿童",
        "gender": "all",
        "age_min": null,
        "age_max": null,
        "evidence_ids": [
          "（三）中毒型。\n全身中毒症状明显，高热、头痛、剧烈呕吐，惊厥、神志不清，甚至昏迷，可出现中毒性心肌炎、中毒型肝炎及中毒性休克综合征。"
        ],
        "confidence": 0.9
