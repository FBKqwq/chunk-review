        "age_min": null,
        "age_max": null,
        "evidence_ids": [
          "呼吸系统 长新冠综合征常见的呼吸道症状包括胸闷、呼吸困难、慢性咳嗽和运动能力下降［43］等，部分症状甚至可能持续长达3年［44］。呼吸困难是最常见的长新冠综合征相关症状［43］……长新冠综合征常遗留肺功能异常，包括限制性通气功能障碍、弥散功能下降［48-49］……长新冠综合征部分患者存在包括炎症改变（磨玻璃影和实变）和纤维化改变（网状结构、肺结构扭曲、小叶间隔增厚、牵拉性支气管扩张）的胸部影像学异常［51］……"
        ],
        "confidence": 0.9
      },
      {
        "id": "sub_disease_long_covid_cardiovascular",
        "name": "心血管系统长新冠综合征",
        "parent_disease_id": "disease_long_covid_syndrome",
