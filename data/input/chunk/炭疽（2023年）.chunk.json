    {
      "chunk_id": "CH0006",
      "section_title": "三、发病机制",
      "section_path": [
        "正文",
        "三、发病机制"
      ],
      "page_start": 3,
      "page_end": 3,
      "page_span": {
        "start": {
          "page": 3,
          "offset": 0
        },
