    {
      "chunk_id": "CH0007",
      "section_title": "四、病理改变",
      "section_path": [
        "正文",
        "四、病理改变"
      ],
      "page_start": 2,
      "page_end": 3,
      "page_span": {
        "start": {
          "page": 2,
          "offset": 367
        },
        "end": {
          "page": 3,
          "offset": 81
        }
      },
      "text_span": {
        "start": 913,
        "end": 1055
      },
      "text": "四、病理改变\nSFTS病理损伤广泛，主要表现为心肌细胞结构紊乱伴\n空泡变性，肺泡出血及间质纤维增生，肝脏汇管区增大、肝\n\n窦充血、嗜酸性变，脾脏明显充血、局灶性出血及缺血性损\n伤，肾小管弥漫性扩张伴肾小管上皮细胞肿大，桥脑局灶性\n神经元细胞变性，骨髓造血功能减低，可见巨噬细胞增多。",
      "text_quality": {
        "cjk_ratio": 0.8741
      },
      "anchors": {
