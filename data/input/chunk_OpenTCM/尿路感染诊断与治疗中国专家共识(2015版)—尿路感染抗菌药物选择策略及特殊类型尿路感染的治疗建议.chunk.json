    {
      "chunk_id": "CH0003",
      "section_title": "一抗菌药物选择策略",
      "section_path": [
        "正文",
        "一抗菌药物选择策略"
      ],
      "page_start": 1,
      "page_end": 1,
      "page_span": {
        "start": {
          "page": 1,
          "offset": 188
        },
        "end": {
